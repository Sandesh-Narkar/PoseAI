# ==============================================================================
# PoseAI — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development.
# Fill in real values locally or in your deployment dashboard (e.g., Render).
# WARNING: NEVER commit your actual `.env` file or secrets to Git.
# ==============================================================================

# ── Application Environment & Server ─────────────────────────────────────────
# APP_ENV: "development", "test", or "production"
# (ENVIRONMENT, NODE_ENV, and FLASK_ENV are also accepted for cross-platform compatibility)
APP_ENV=development
ENVIRONMENT=development
PORT=5000
PYTHON_VERSION=3.11.9

# ── Flask & Session Secrets ──────────────────────────────────────────────────
# Required in production. Generate a strong 64-character random hex string:
# python -c "import secrets; print(secrets.token_hex(32))"
# In Render Blueprint, this is generated automatically via generateValue: true
SECRET_KEY=your-production-secret-key-min-32-chars
FLASK_SECRET_KEY=your-production-secret-key-min-32-chars
SESSION_SECRET=

# ── MongoDB Database ─────────────────────────────────────────────────────────
# MongoDB Atlas connection string with TLS/SSL enabled.
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
# (Accepts MONGODB_URI or MONGO_URI interchangeably)
MONGODB_URI=mongodb+srv://db_user:db_password@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGODB_DATABASE=poseai
MONGO_DB_NAME=poseai
MONGO_CONNECT_TIMEOUT_MS=4000

# Set to 1 ONLY for offline local development without MongoDB.
# Set to 0 in production (enforced automatically when APP_ENV=production).
MONGO_ALLOW_MOCK=0

# Optional legacy SQLite database URL for tests or local inspection
DATABASE_URL=sqlite:///poseai.db

# ── CORS & Domain Configuration ──────────────────────────────────────────────
# In production, set to your frontend domain or Render static site URL
# Multiple origins can be comma-separated: https://poseai.onrender.com,https://poseai.vercel.app
FRONTEND_URL=https://your-frontend-domain.onrender.com
ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com
CORS_ORIGINS=

# ── Session Cookie Security ──────────────────────────────────────────────────
# In production with HTTPS / cross-origin domains, set SECURE=1 and SAMESITE=None
# In local development without HTTPS, set SECURE=0 and SAMESITE=Lax
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# ── Security, Rate Limiting & CSRF ───────────────────────────────────────────
# Have I Been Pwned API breach checking for user password strength (k-anonymity)
HIBP_CHECK_ENABLED=1

# Sliding window rate limiter for login, signup, and sensitive actions
RATE_LIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://

# Form & API CSRF validation
WTF_CSRF_ENABLED=1
WTF_CSRF_CHECK_DEFAULT=0

# ── Google OAuth 2.0 (Optional) ──────────────────────────────────────────────
# Obtain credentials from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-domain.onrender.com/auth/google/callback

# Dev stub bypass (local dev only - NEVER enable in production)
GOOGLE_OAUTH_DEV_MODE=0
GOOGLE_DEV_EMAIL=google.dev@example.com
GOOGLE_DEV_NAME=Google Dev Athlete

# ── AI & Nutrition Services (Optional) ───────────────────────────────────────
# Google Gemini 2.5 Flash API Key for visual food recognition
# Accepts GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=

# USDA FoodData Central API Key (from https://fdc.nal.usda.gov/api-key-signup.html)
USDA_API_KEY=your-usda-api-key

# ── Desktop CV Client (Optional / Dev Only) ─────────────────────────────────
# When running main.py on a local desktop with a webcam, target the backend API
DASHBOARD_API_URL=http://127.0.0.1:5000/api/update
